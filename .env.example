# GradLeadAI Backend — environment variables
# Copy this file to `.env`, fill in real values, then run `npm run dev`.
# Required for all features unless marked optional. Never commit the real `.env`.

# ---- Database (Turso / libSQL) -----
# REQUIRED — the hosted Turso database connection and auth token.
# Point the local CLI at the file data/leadflow.db or a hosted Turso DB URL.
# Get these from https://turso.tech (database + token) or a local turso instance.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_access_token

# ---- AI (OpenAI-compatible gateway) ----
# REQUIRED for AI Chat, Email, WhatsApp, Call, and Image features.
# baseURL must point at an OpenAI-compatible endpoint.
#   Direct OpenAI:            https://api.openai.com/v1
#   OpenRouter:               https://openrouter.ai/api/v1
AI_API_KEY=sk-your-api-key
AI_BASE_URL=https://api.openai.com/v1

# OPTIONAL — text model used by chat/email/whatsapp/call (default shown).
AI_MODEL=openai/gpt-5.6-luna

# OPTIONAL — image model used by the Creative Studio (default: gpt-image-2).
# Must be supported by the gateway at {AI_BASE_URL}/images/generations.
AI_IMAGE_MODEL=gpt-image-2

# ---- Gmail SMTP + IMAP (real email send/receive in Email Studio) ----
# REQUIRED for the real send + inbox sync features. Emails are sent from and
# synced from this Gmail account.
#
# GMAIL_APP_PASSWORD must be a Gmail App Password, NOT your normal account
# password — Gmail requires 2-Step Verification to be enabled on the account,
# then an app password generated at https://myaccount.google.com/apppasswords.
# It's a 16-character code (shown with spaces, e.g. "abcd efgh ijkl mnop" —
# spaces don't matter, both forms work).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# OPTIONAL — SMTP/IMAP hosts (defaults shown; only change for a non-Gmail
# provider that speaks the same protocols, e.g. Google Workspace with a
# custom domain still uses these same hosts).
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_IMAP_HOST=imap.gmail.com

# ---- Phase 2 — WhatsApp via RelayX bridge ----
# Inbound webhook + outbound send. All of these are OPTIONAL — WhatsApp
# features simply stay inert until set.
#
# OPTIONAL — enables sending. The RelayX API key (sent as X-Api-Key).
RELAYX_API_KEY=
# OPTIONAL — base URL of your RelayX instance
# (e.g. https://whatssapi.vercel.app or http://localhost:3000).
RELAYX_BASE_URL=
# OPTIONAL — session name on the bridge (default: default).
RELAYX_SESSION=default
# OPTIONAL — our sending WhatsApp number in E.164 (e.g. 15551234567).
RELAYX_FROM_NUMBER=
# OPTIONAL — a shared secret matched against inbound webhook headers
# (x-webhook-secret or x-api-key). When set, inbound POSTs are rejected without it.
RELAYX_WEBHOOK_SECRET=
# OPTIONAL — off-hours acknowledgement window (24h HH:MM in a named tz).
RELAYX_WORKING_HOURS_START=09:00
RELAYX_WORKING_HOURS_END=18:00
RELAYX_WORKING_TZ=America/New_York

# ---- Phase 0 — Conversation SLA ----
# OPTIONAL — how long a human/AI has to respond to an inbound message before
# the conversation-level SLA "breaches" (default 4 hours). Powers alerting.
SLA_RESPONSE_HOURS=4

# ---- Server / CORS ----
# OPTIONAL — extra allowed CORS origins, comma-separated. The dev origins
# (localhost:5173, localhost:3000) and the Hostinger frontend are always allowed.
# Comma-separated list of additional frontend origins to allow (beyond the
# hardcoded localhost + primary deployed origin in src/index.ts).
CORS_ORIGINS=https://www.gradleadai.com,https://gradleadai.com

# OPTIONAL — HTTP port for local dev server (default 3001). Matches the
# Vite dev proxy target in Leads-Normal-Frontend/vite.config.ts.
PORT=3001

# OPTIONAL — "development" starts the local listener; "production" runs
# serverless (no listener) for Vercel.
NODE_ENV=development

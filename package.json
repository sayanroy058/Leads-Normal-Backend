{
  "name": "leads-backend",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env --import tsx/esm src/index.ts",
    "build": "esbuild src/vercel.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=api/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.0",
    "@hono/node-server": "^2.0.12",
    "@libsql/client": "^0.17.4",
    "@node-rs/argon2": "^2.0.2",
    "ai": "^7.0.2",
    "bcryptjs": "^3.0.3",
    "hono": "^4.6.0",
    "imapflow": "^1.7.1",
    "mailparser": "^3.9.15",
    "nodemailer": "^9.0.5",
    "tsx": "^4.23.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.8.3"
  }
}
